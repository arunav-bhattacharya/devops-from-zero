{
  "mcpServers": {
    "kubernetes": {
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@0.1.2",
        "--config",
        "${HOME}/.config/hello-devops-k8s-mcp.toml"
      ],
      "env": {
        "KUBECONFIG": "${HOME}/.kube/ai-agent.kubeconfig"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "repos,issues,pull_requests,actions",
        "X-MCP-Lockdown": "true"
      }
    }
  }
}
