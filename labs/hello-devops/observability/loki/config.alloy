// Grafana Alloy for the laptop lab (Day 46): read the logs of this Compose
// project's containers from Docker and send them to Loki.
// Each block is a component. Data flows from one to the next:
//   discovery.docker -> discovery.relabel -> loki.source.docker -> loki.write
// See it live in the Alloy UI: http://localhost:12345

// 1. Ask Docker which containers exist. Keep only this Compose project.
//    compose.loki.yaml passes the project name in COMPOSE_PROJECT.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT")]
  }
}

// 2. Choose the labels each log stream gets in Loki. Keep them few:
//    every new label value makes a new stream.
discovery.relabel "containers" {
  targets = []

  // service="web", "prometheus", "grafana", ... (the Compose service name).
  // Loki also copies it into service_name.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // container="observability-web-1" (Docker puts a "/" in front; drop it).
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// 3. Follow each container's output (stdout and stderr), like docker logs -f.
loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.local.receiver]
}

// 4. Push the lines to Loki's API.
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
