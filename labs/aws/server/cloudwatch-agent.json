{
  "logs": {
    "logs_collected": {
      "journald": {
        "collect_list": [
          {
            "log_group_name": "/hello-devops/app",
            "log_stream_name": "{instance_id}",
            "units": ["hello-devops"],
            "retention_in_days": 7
          }
        ]
      }
    }
  }
}
