{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTheAppFolder",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::hello-devops-app-ACCOUNT_ID",
      "Condition": { "StringLike": { "s3:prefix": ["app/*"] } }
    },
    {
      "Sid": "ReadTheAppFiles",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::hello-devops-app-ACCOUNT_ID/app/*"
    }
  ]
}
